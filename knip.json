{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "bin/*.mjs",
    "scripts/**/*.{mjs,ts}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "web/**/*.{ts,tsx}",
    "bin/**/*.mjs",
    "scripts/**/*.{mjs,ts}"
  ],
  "ignoreBinaries": [
    "flock",
    "tailscale",
    "mise",
    "bwrap",
    "sha256sum",
    "rg",
    "opencode",
    "codex",
    "ffmpeg",
    "uv"
  ],
  "ignoreDependencies": [
    "esbuild",
    "playwright",
    "@xterm/xterm"
  ],
  "ignoreExportsUsedInFile": true
}
